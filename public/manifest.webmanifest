
{
  "id": "/Voice-to-text/",
  "name": "VoiceToText",
  "short_name": "VoiceToText",
  "description": "Trascrivi e riassumi i messaggi vocali.",
  "start_url": "/Voice-to-text/",
  "scope": "/Voice-to-text/",
  "display": "standalone",
  "background_color": "#f8fafc",
  "theme_color": "#111827",
  "icons": [
    {
      "src": "/Voice-to-text/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/Voice-to-text/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/Voice-to-text/share-target.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "audio",
          "accept": [
            "audio/*",
            ".ogg",
            ".opus",
            ".m4a",
            ".mp3",
            ".wav",
            ".aac"
          ]
        }
      ]
    }
  }
}
